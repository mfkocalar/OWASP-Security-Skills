.DS_Store
node_modules/
*.log
dist/
build/
*.swp
*.swo
.vscode/
.idea/

# Prevent nested git repositories (important for monorepos)
**/.git/
!.git

# Skill directories
.claude/skills/
.github/skills/
.agents/skills/

# Claude Code plugin test-scope local settings (written by
# `claude plugin ... --scope local` during Checkpoint-1 install validation)
.claude/settings.local.json

# Build and temp files
*.tmp
*.cache
.env
.env.local
__pycache__/
*.pyc

# IDE and editor files
.eslintignore
.prettierignore

# Skill-creator eval workspace (local scratch data — benchmark runs, grading outputs)
owasp-security-audit-workspace/
